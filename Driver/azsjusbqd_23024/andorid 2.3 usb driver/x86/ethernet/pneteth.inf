
[version]
Signature   = "$Windows NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %jft%
DriverVer   =08/31/2010,2.52.0.0
CatalogFile.NTx86 =pnetethx86.cat
CatalogFile.NTamd64 =pnetethx64.cat

[ControlFlags]
ExcludeFromSelect={b85b7c50-6a01-11d2-b841-00c04fad5171}\pneteth

[Manufacturer]
%jft% = jft,NTx86,NTamd64

;For Win2k

[jft]
%pneteth.DeviceDesc%    = pneteth.ndi, pneteth ; Root enumerated 

;For WinXP and later

[jft.NTx86]
%pneteth.DeviceDesc%    = pneteth.ndi, pneteth ; Root enumerated 

[jft.NTamd64]
%pneteth.DeviceDesc%    = pneteth.ndi, pneteth ; Root enumerated 

[pneteth.ndi]
Characteristics = 0x1 ; NCF_VIRTUAL
AddReg          = pneteth.Reg
CopyFiles       = pneteth.CopyFiles

[pneteth.ndi.Services]
AddService      = pneteth, 2, pneteth.Service, pneteth.EventLog

;-----------------------------------------------------------------------------
; Microsoft Virtual Miniport Common
;
[pneteth.Reg]
HKR,    ,                         BusNumber,           0, "0" 
HKR, Ndi,                         Service,             0, "pneteth"
HKR, Ndi\Interfaces,              UpperRange,          0, "ndis5"
HKR, Ndi\Interfaces,              LowerRange,          0, "ethernet"

;-----------------------------------------------------------------------------
; Driver and Service Section
;
[pneteth.CopyFiles]
pneteth.sys,,,2

[pneteth.Service]
DisplayName     = %pneteth.Service.DispName%
ServiceType     = 1 ;%SERVICE_KERNEL_DRIVER%
StartType       = 3 ;%SERVICE_DEMAND_START%
ErrorControl    = 1 ;%SERVICE_ERROR_NORMAL%
ServiceBinary   = %12%\pneteth.sys
LoadOrderGroup  = NDIS
AddReg          = TextModeFlags.Reg

[pneteth.EventLog]
AddReg = pneteth.AddEventLog.Reg

[pneteth.AddEventLog.Reg]
HKR, , EventMessageFile, 0x00020000, "%%SystemRoot%%\System32\netevent.dll"
HKR, , TypesSupported,   0x00010001, 7

[TextModeFlags.Reg]
HKR, , TextModeFlags,    0x00010001, 0x0001

[SourceDisksNames]
1 = %DiskId1%,,,\i386
2 = %DiskId1%,,,\amd64


[SourceDisksFiles.x86]
pneteth.sys  = 1,,

[SourceDisksFiles.amd64]
pneteth.sys  = 2,,

;-----------------------------------------------------------------------------
; DestinationDirs
;
[DestinationDirs]
pneteth.CopyFiles = 12

;-----------------------------------------------------------------------------
; Localizable Strings
;
[Strings]
jft                       = "June Fabrics Technology Inc."                      
pneteth.DeviceDesc        = "PdaNet Broadband Adapter"
pneteth.Service.DispName    = "PdaNet Broadband"
DiskId1 = PdaNet Phone Broadband Device Installation Disk #1"

